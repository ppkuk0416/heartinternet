# Public canonical URL used for sitemap.xml, robots.txt, and metadata.
# Set this to the production Vercel or custom-domain URL without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Supabase public browser configuration.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Server-only Supabase service role. Never expose this in NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Server-only privacy-preserving event hashing secrets.
COPY_EVENT_HASH_SECRET=replace-with-random-secret
ANALYTICS_EVENT_HASH_SECRET=replace-with-random-secret

# Optional deployment/runtime labels.
APP_ENV=development
APP_RELEASE=local
