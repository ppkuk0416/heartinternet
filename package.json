{
  "name": "hearthdeck-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "monitoring:test": "tsx scripts/test-error-monitoring.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db supabase/tests --local",
    "db:validate": "node scripts/validate-database.mjs",
    "cards:dry-run": "tsx scripts/sync-cards.mjs",
    "cards:sync": "tsx scripts/sync-cards.mjs --write",
    "decks:track:dry-run": "tsx scripts/import-deck-candidates.ts",
    "decks:track": "tsx scripts/import-deck-candidates.ts --write",
    "decks:feeds:dry-run": "tsx scripts/track-deck-feeds.ts",
    "decks:feeds": "tsx scripts/track-deck-feeds.ts --write",
    "decks:event:dry-run": "tsx scripts/import-official-event.ts",
    "decks:event": "tsx scripts/import-official-event.ts --write",
    "patch:check": "tsx scripts/check-hearthstone-patch.ts",
    "patch:activate": "tsx scripts/check-hearthstone-patch.ts --write --approve"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "deckstrings": "^3.1.2",
    "fast-xml-parser": "^5.8.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "jsdom": "^29.1.1",
    "supabase": "^2.105.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "postcss": "8.5.15"
  }
}
